<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera permission -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <!--
      Removed permissions (all of these were unused, and unused dangerous permissions
      are a Google Play review trigger on targetSdk 34):
        * READ_EXTERNAL_STORAGE / WRITE_EXTERNAL_STORAGE - nothing in this app ever
          touched external storage; face templates live in app-private filesDir.
        * WAKE_LOCK - the wake lock it backed was held by an Activity whose only work
          is a camera preview, i.e. while the screen is already on.
        * FOREGROUND_SERVICE / FOREGROUND_SERVICE_CAMERA - see FaceDetectionService,
          which has been deleted (it never used the camera; a camera-typed foreground
          service with no camera use is exactly what Play rejects).
        * REQUEST_IGNORE_BATTERY_OPTIMIZATIONS - a Play-restricted permission that was
          requesting exemption for a no-op background loop.
      Had the camera-typed foreground service been kept, Android 14 (targetSdk 34)
      would have thrown SecurityException at startForeground for the missing
      FOREGROUND_SERVICE_CAMERA permission.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FaceRecognitionApp">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face" />
    </application>

</manifest>
