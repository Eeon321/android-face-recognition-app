    <string name="enter_name">Enter name for face registration</string>
    <string name="name_hint">Name</string>
    <string name="register_disclaimer">Stores a coarse pose/geometry template on this device only. This is not a secure biometric enrolment.</string>
    <string name="save">Save</string>
    <string name="cancel">Cancel</string>
</resources>
