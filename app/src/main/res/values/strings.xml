    <string name="app_name">Face Recognition App</string>
    <string name="camera_permission_required">Camera permission required</string>
    <string name="camera_permission_message">This app detects and draws boxes around faces using your camera. Nothing is uploaded: frames are processed on-device and never saved. Without the permission the camera preview cannot start.</string>
    <string name="allow">Allow</string>
    <string name="open_settings">Open app settings</string>
