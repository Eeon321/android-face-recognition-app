    <string name="no_face_detected">No face detected. Please position your face in the frame.</string>
    <!--
      Wording matters here. The matcher compares head pose, expression probabilities and
      eye-distance-normalised landmark geometry. That is a coarse similarity signal, not an
      identity check, so the UI says "possible match" instead of asserting who a person is.
      See the note in FaceRecognizer.kt.
    -->
    <string name="candidate_match">Possible match: %1$s (pose/geometry similarity, not verified identity)</string>
    <string name="unknown_face">Face detected, no registered match</string>
    <string name="unknown_face_label">Unknown</string>
